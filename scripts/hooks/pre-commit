#!/usr/bin/env bash
# Copyright 2026 Jason Hall
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-private.sh"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner "$root"
else
  echo "pre-commit: gitleaks not installed; secret scan skipped (brew install gitleaks)" >&2
fi
