# Copy to .env and fill in. Never commit .env.

# The external URL people use (no trailing slash).
CHRYSALIS_BASE_URL=https://board.example.home

CHRYSALIS_AUTH_MODE=oidc
CHRYSALIS_OIDC_ISSUER=https://auth.example.com
CHRYSALIS_OIDC_CLIENT_ID=chrysalis
CHRYSALIS_OIDC_CLIENT_SECRET=replace-me
# Redirect URL to register with your identity provider:
#   https://board.example.home/auth/callback
# Optional: only members of these groups may sign in.
# CHRYSALIS_OIDC_ALLOWED_GROUPS=family

# Optional: pin a release instead of latest.
# CHRYSALIS_VERSION=0.1.0
